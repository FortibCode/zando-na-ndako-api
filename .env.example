VITE_APP_NAME="${APP_NAME}"

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Calcul du prix de livraison par itinéraire réel (openrouteservice.org, gratuit, sans CB)
ORS_API_KEY=

# Paiement Stripe — STRIPE_WEBHOOK_SECRET vérifie que les webhooks reçus sur /api/webhooks/stripe
# viennent bien de Stripe (Dashboard Stripe > Webhooks > votre endpoint > "Signing secret").
# Tant qu'il n'est pas renseigné, le webhook est traité sans vérification (mode dev).
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Paiement PayPal (PayPal Developer Dashboard > Apps & Credentials). Tant que PAYPAL_CLIENT_ID
# n'est pas renseigné, les paiements PayPal restent simulés (mode dev).
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox

# Connexion Google (console.cloud.google.com > APIs & Services > Identifiants > créer un ID client
# OAuth de type "Application Web"). Liste séparée par des virgules car web/iOS/Android auront chacun
# leur propre Client ID une fois l'app publiée — pour l'instant, un seul Client ID Web suffit à tester
# le flux de bout en bout. Tant que GOOGLE_CLIENT_IDS est vide, /api/auth/google refuse toute requête.
GOOGLE_CLIENT_IDS=

# Paiement MTN Mobile Money (MTN MoMo Developer Portal > Collections). Tant que les 3 identifiants
# Collection ne sont pas renseignés, les paiements MTN MoMo restent simulés (mode dev).
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_TARGET_ENVIRONMENT=
MTN_MOMO_CURRENCY=XAF
MTN_MOMO_COLLECTION_USER_ID=
MTN_MOMO_COLLECTION_API_KEY=
MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=
MTN_MOMO_DISBURSEMENT_USER_ID=
MTN_MOMO_DISBURSEMENT_API_KEY=
MTN_MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=

# Paiement Airtel Money (Airtel Africa Open API > Collections). Tant que AIRTEL_MONEY_CLIENT_ID/
# _CLIENT_SECRET ne sont pas renseignés, les paiements Airtel Money restent simulés (mode dev).
AIRTEL_MONEY_ENVIRONMENT=sandbox
AIRTEL_MONEY_COUNTRY=CG
AIRTEL_MONEY_CURRENCY=XAF
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
