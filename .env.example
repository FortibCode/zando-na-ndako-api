SUPABASE_S3_KEY=ae24e666c0545301393c7b62d64a65cc
SUPABASE_S3_SECRET=9c923a82c94c52796b0a526c97c932064c7c40d643d8b10a041365d7317593d0
SUPABASE_S3_REGION=eu-west-2
SUPABASE_S3_BUCKET=media
SUPABASE_S3_ENDPOINT=https://ixqgpgcxadtomgriiczh.storage.supabase.co/storage/v1/s3
