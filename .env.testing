APP_ENV=testing
APP_KEY=base64:sgTOHXBNdhraj7vS++TIJMcXOywkDOvn7GjPRRD0/lE=
APP_DEBUG=true

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=zando_na_ndako_testing
DB_USERNAME=postgres
DB_PASSWORD=postgres

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=null
BCRYPT_ROUNDS=4

# DashboardCache utilise explicitement Cache::store('redis') quel que soit CACHE_STORE : sans ces
# variables, la connexion par défaut tente le client 'phpredis' (extension PHP non installée sur
# cette machine), échoue silencieusement (try/catch volontaire dans DashboardCache), et les tests
# qui vérifient la mise en cache passent alors "par hasard" sans jamais rien mettre en cache.
# REDIS_CACHE_DB séparée de celle du dev (1) pour ne pas polluer/être polluée par son cache.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_CACHE_DB=2
